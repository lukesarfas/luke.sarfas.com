---
import Base from "~/layouts/Base.astro";
import { loadAll } from "~/lib/manifests";

export async function getStaticPaths() {
  const projects = await loadAll();
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
---

<Base title={`${project.name} — Luke Sarfas`} description={project.tagline}>
  <p><a href="/projects">← Projects</a></p>
  <h1>{project.name}</h1>
  {project.tagline && <p class="muted">{project.tagline}</p>}

  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:0.75rem;font-size:0.9rem">
    {project.status && <span class={`status-${project.status}`}>● {project.status}</span>}
    {project.version && <span class="muted">v{project.version}</span>}
    {project.updated && <span class="muted">updated {project.updated}</span>}
  </div>

  {project.description && <p style="margin-top:1.25rem">{project.description}</p>}

  {project.links && (
    <div style="margin-top:1rem;display:flex;gap:1rem;flex-wrap:wrap">
      {project.links.site && <a href={project.links.site}>Site ↗</a>}
      {project.links.demo && <a href={project.links.demo}>Demo ↗</a>}
      {project.links.repo && <a href={project.links.repo}>Repo ↗</a>}
      {project.links.docs && <a href={project.links.docs}>Docs ↗</a>}
    </div>
  )}

  {project.tags && project.tags.length > 0 && (
    <div style="margin-top:1.25rem">
      {project.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</Base>
