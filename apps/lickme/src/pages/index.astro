---
import Base from "~/layouts/Base.astro";
import Container from "@sarfas/ui/Container.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import NotationDemo from "~/components/NotationDemo";

const title = "LickMe — share a lick, watch it played";
const description =
  "LickMe is where musicians publish short improvisational phrases as notation, and other players upload videos of those licks living inside real songs.";
---

<Base title={title} description={description}>
  <Header />

  <main>
    <Container as="section" class="hero">
      <span class="eyebrow">Coming soon</span>
      <h1>
        Share a lick. <span class="text-gradient">Watch it played.</span>
      </h1>
      <p class="lead">
        LickMe is where musicians publish short phrases as notation, and other
        players upload videos of those licks living inside real songs.
      </p>
      <div class="actions">
        <a
          class="btn btn-primary"
          href="mailto:lukesarfas@icloud.com?subject=LickMe%20waitlist"
        >
          Get notified
        </a>
        <a class="btn" href="#how-it-works">How it works</a>
      </div>
    </Container>

    <Container as="section" class="section">
      <h2>Notation, in the browser.</h2>
      <p class="muted">
        Paste a lick in ABC. We render it. The page below is rendered live
        from a few lines of text — no PDF, no image export, no plugin.
      </p>
      <div class="demo-frame">
        <NotationDemo client:visible />
      </div>
    </Container>

    <Container as="section" class="section">
      <div class="features">
        <article class="feature">
          <h3>Notation that travels</h3>
          <p class="muted">
            Write a lick in ABC or plain text. It renders as standard notation
            on the page, on any device, with no install.
          </p>
        </article>
        <article class="feature">
          <h3>Video receipts</h3>
          <p class="muted">
            Every lick collects short videos of it being played in real songs.
            Pinned solos, real bands, real proof the line works.
          </p>
        </article>
        <article class="feature">
          <h3>Browse and follow</h3>
          <p class="muted">
            Filter by key, tempo, tag, or instrument. Follow players whose
            vocabulary you want to steal.
          </p>
        </article>
      </div>
    </Container>

    <Container as="section" id="how-it-works" class="section">
      <h2>How it works</h2>
      <ol class="steps">
        <li>
          <span class="num">1</span>
          <div>
            <strong>Write a lick.</strong>
            <p class="muted">
              Notation, a key, a tempo, a few tags. Optional audio reference.
            </p>
          </div>
        </li>
        <li>
          <span class="num">2</span>
          <div>
            <strong>Someone plays it.</strong>
            <p class="muted">
              Another musician sees your lick, learns it, drops it into a solo
              on something they're already gigging, and posts a short clip.
            </p>
          </div>
        </li>
        <li>
          <span class="num">3</span>
          <div>
            <strong>The lick grows.</strong>
            <p class="muted">
              The page becomes a living document — every video is a small
              lesson in how that line breathes in real music.
            </p>
          </div>
        </li>
      </ol>
    </Container>

    <Container as="section" class="section cta-band">
      <h2>Want to be in the first wave?</h2>
      <p class="muted">
        LickMe is in active development. Email me and I'll add you to the list.
      </p>
      <a
        class="btn btn-primary"
        href="mailto:lukesarfas@icloud.com?subject=LickMe%20waitlist"
      >
        Get notified
      </a>
    </Container>
  </main>

  <Footer />
</Base>

<style>
  main {
    padding: 1.5rem 0 4rem;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding-top: 4rem;
    padding-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .hero .lead {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.55;
  }
  .hero .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .eyebrow {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
  }

  .section {
    margin-top: 4.5rem;
  }
  .section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }
  .section h2 + p {
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .muted {
    color: var(--muted);
    line-height: 1.55;
  }

  .demo-frame {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.92);
    padding: 1.5rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    min-height: 200px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .feature {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    padding: 1.25rem 1.4rem;
    transition:
      border-color 200ms var(--ease),
      background 200ms var(--ease);
  }
  .feature:hover {
    border-color: var(--border-strong);
    background: var(--card-hover);
  }
  .feature h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    max-width: 720px;
  }
  .steps li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .steps li strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1rem;
  }
  .steps li p {
    margin: 0;
  }
  .steps .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--grad-1);
    color: #0d0f14;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .cta-band {
    text-align: center;
    padding: 3rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    margin-top: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .cta-band .btn {
    margin-top: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      transform 160ms var(--ease),
      background 160ms var(--ease),
      border-color 160ms var(--ease);
  }
  .btn:hover {
    background: var(--card-hover);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .btn-primary {
    background: var(--grad-1);
    color: #0d0f14;
    border-color: transparent;
    font-weight: 600;
  }
  .btn-primary:hover {
    filter: brightness(1.05);
    color: #0d0f14;
  }
</style>
