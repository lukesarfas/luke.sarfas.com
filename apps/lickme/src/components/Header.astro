---
import Container from "@sarfas/ui/Container.astro";
---

<header class="header">
  <Container class="header-inner">
    <a href="/" class="brand">
      <svg
        width="22"
        height="22"
        viewBox="0 0 32 32"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="hdrg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#8b9dff" />
            <stop offset="60%" stop-color="#c4a6ff" />
            <stop offset="100%" stop-color="#6dd5d3" />
          </linearGradient>
        </defs>
        <path
          d="M8 22 Q12 8 16 14 T24 12"
          stroke="url(#hdrg)"
          stroke-width="2.5"
          fill="none"
          stroke-linecap="round"
        />
        <circle cx="8" cy="22" r="2" fill="url(#hdrg)" />
        <circle cx="24" cy="12" r="2" fill="url(#hdrg)" />
      </svg>
      <span>LickMe</span>
    </a>
    <nav class="nav">
      <a href="/about">About</a>
      <a
        href="mailto:lukesarfas@icloud.com?subject=LickMe%20waitlist"
        class="cta"
      >
        Get notified
      </a>
    </nav>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(8, 9, 12, 0.6);
    border-bottom: 1px solid var(--border);
  }
  .header :global(.header-inner) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
    font-size: 1rem;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav a {
    color: var(--muted);
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    font-size: 0.92rem;
    text-decoration: none;
    transition:
      color 160ms var(--ease),
      background 160ms var(--ease);
  }
  .nav a:hover {
    color: var(--fg);
    background: var(--card);
  }
  .nav a.cta {
    color: var(--fg);
    border: 1px solid var(--border-strong);
    background: var(--card);
    margin-left: 0.25rem;
  }
  .nav a.cta:hover {
    border-color: var(--accent);
  }
  @media (max-width: 540px) {
    .nav a {
      padding: 0.4rem 0.55rem;
      font-size: 0.85rem;
    }
  }
</style>
