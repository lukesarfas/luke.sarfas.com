---
import type { ProjectManifest } from "~/lib/manifests";
import Preview from "~/components/Preview.astro";

interface Props {
  project: ProjectManifest;
}

const { project } = Astro.props;
const statusClass = project.status ? `status-${project.status}` : "";
---

<a class="pcard" href={`/projects/${project.slug}/`}>
  <div class="preview">
    <Preview project={project} />
  </div>
  <div class="body">
    <div class="head">
      <strong>{project.name}</strong>
      {project.status && <span class={`status ${statusClass}`}>{project.status}</span>}
    </div>
    {project.tagline && <p class="tagline">{project.tagline}</p>}
    {project.tags && project.tags.length > 0 && (
      <div class="tags">
        {project.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
  </div>
</a>
