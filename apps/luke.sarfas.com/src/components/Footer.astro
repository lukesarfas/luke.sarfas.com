---
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap footer-inner">
    <span><span class="footer-mark">L</span> &copy; {year} Luke Sarfas, London</span>
    <nav class="footer-links" aria-label="Footer">
      <a href="mailto:luke@sarfas.com">Email</a>
      <a href="https://www.linkedin.com/in/lukesarfas/" rel="me noreferrer">LinkedIn</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .footer-mark {
    display: inline-block;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--signature);
    color: oklch(0.18 0.018 264);
    text-align: center;
    line-height: 22px;
    font-family: var(--font-serif);
    font-size: 16px;
    margin-right: 0.45rem;
    vertical-align: -4px;
  }
  .footer-inner > span {
    display: inline-flex;
    align-items: center;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  @media (max-width: 540px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>
