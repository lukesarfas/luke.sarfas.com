---
import "~/styles/global.css";
import MetaTags from "@sarfas/ui/MetaTags.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: object | object[];
}

const SITE_URL = "https://luke.sarfas.com";
const {
  title,
  description = "Luke Sarfas. Software engineer and machine-learning practitioner. Projects, writing, and what I'm building.",
  image,
  imageAlt,
  type = "website",
  publishedTime,
  modifiedTime,
  tags,
  jsonLd,
} = Astro.props;

const url = new URL(Astro.url.pathname, SITE_URL).toString();
const absImage = image
  ? (image.startsWith("http") ? image : new URL(image, SITE_URL).toString())
  : undefined;

const ldEntries = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];

const BUILD_VERSION = (import.meta.env as Record<string, string>).BUILD_VERSION ?? "dev";
const BUILD_TIME = (import.meta.env as Record<string, string>).BUILD_TIME ?? new Date().toISOString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0c0d12" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Luke Sarfas"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
    />

    <MetaTags
      title={title}
      description={description}
      url={url}
      image={absImage}
      imageAlt={imageAlt}
      type={type}
      author="Luke Sarfas"
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    {ldEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <meta name="build-version" content={BUILD_VERSION} />
    <meta name="build-time" content={BUILD_TIME} />

    <ViewTransitions />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />

    <div id="update-banner" hidden role="status" aria-live="polite">
      <span>A new version of this site is available.</span>
      <button type="button" id="update-reload">Reload</button>
      <button type="button" id="update-dismiss" aria-label="Dismiss">×</button>
    </div>

    <style is:global>
      #update-banner {
        position: fixed;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.7rem 0.65rem 1.1rem;
        background: var(--bg-1);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        box-shadow: var(--shadow-strong);
        font-size: 0.88rem;
        color: var(--fg);
        z-index: 80;
        animation: bannerIn 280ms var(--ease-out);
      }
      #update-banner[hidden] { display: none; }
      #update-banner button {
        font: inherit;
        cursor: pointer;
        border-radius: 999px;
        border: 1px solid transparent;
        padding: 0.35rem 0.85rem;
      }
      #update-reload {
        background: var(--signature);
        color: oklch(0.18 0.018 264);
        font-weight: 600;
      }
      #update-reload:hover {
        background: color-mix(in oklab, var(--signature) 90%, white);
      }
      #update-dismiss {
        background: transparent;
        color: var(--muted);
        padding: 0.2rem 0.55rem;
        font-size: 1.1rem;
        line-height: 1;
      }
      #update-dismiss:hover { color: var(--fg); }
      @keyframes bannerIn {
        from { opacity: 0; transform: translate(-50%, 12px); }
        to { opacity: 1; transform: translate(-50%, 0); }
      }
    </style>

    <script is:inline define:vars={{ current: BUILD_VERSION }}>
      (() => {
        if (current === "dev") return;
        const KEY = "ls:dismissed-version";
        const banner = document.getElementById("update-banner");
        const reload = document.getElementById("update-reload");
        const dismiss = document.getElementById("update-dismiss");
        if (!banner || !reload || !dismiss) return;

        reload.addEventListener("click", () => {
          sessionStorage.removeItem(KEY);
          location.reload();
        });
        dismiss.addEventListener("click", () => {
          banner.hidden = true;
        });

        async function check() {
          try {
            const res = await fetch("/version.json", { cache: "no-store" });
            if (!res.ok) return;
            const { version } = await res.json();
            if (!version || version === current) return;
            if (sessionStorage.getItem(KEY) === version) return;
            banner.hidden = false;
            sessionStorage.setItem(KEY, version);
          } catch {}
        }
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") check();
        });
        setInterval(check, 120000);
        setTimeout(check, 8000);
      })();
    </script>
  </body>
</html>
