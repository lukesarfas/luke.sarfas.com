---
import Base from "~/layouts/Base.astro";
---

<Base title="Not found · Luke Sarfas" description="That page doesn't exist.">
  <section class="hero" style="padding-top:5rem;padding-bottom:1rem">
    <span class="eyebrow">404</span>
    <h1>Not <span class="gradient-text">found</span></h1>
    <p class="lead">
      Whatever you were looking for, it isn't here. It might have moved, or it
      might never have existed. Either way, sorry about that.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/projects/">Projects</a>
      <a class="btn" href="/blog/">Blog</a>
    </div>
  </section>
</Base>
