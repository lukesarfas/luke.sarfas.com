---
import Base from "~/layouts/Base.astro";

const roles: Array<{
  company: string;
  title: string;
  status: "current" | "past";
  period?: string;
  blurb?: string;
}> = [
  {
    company: "Google",
    title: "Software Engineer",
    status: "current",
    period: "Present, London",
  },
  {
    company: "Amazon",
    title: "Software Development Engineer",
    status: "past",
    blurb: "Machine learning for forecasting metrics in AWS CloudWatch.",
  },
];

const linkedin = "https://www.linkedin.com/in/lukesarfas/";
---

<Base title="Career · Luke Sarfas" description="Software engineering and machine learning. Currently Google, previously Amazon.">
  <section class="hero" style="grid-template-columns:1fr">
    <div class="hero-main">
      <span class="eyebrow">Career</span>
      <h1>Career</h1>
      <p class="lead">
        Software engineering and machine learning. Currently at Google,
        previously Amazon. Based in London.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={linkedin} rel="noreferrer">LinkedIn</a>
        <a class="btn" href="mailto:luke@sarfas.com">Email</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Roles</h2>
    </div>
    <ol class="roles">
      {roles.map((r) => (
        <li>
          <div class="role-head">
            <strong>{r.title}</strong>
            <span class="muted">{r.company}</span>
            {r.status === "current" && <span class="badge">Current</span>}
          </div>
          {r.period && <span class="role-period">{r.period}</span>}
          {r.blurb && <p>{r.blurb}</p>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .roles li {
    position: relative;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition: border-color 240ms var(--ease), background 240ms var(--ease);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .roles li:hover {
    border-color: color-mix(in oklab, var(--signature) 30%, var(--border-strong));
    background: var(--card-hover);
  }
  .role-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.1;
  }
  .role-head strong {
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .role-head .muted {
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
  .role-period {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .roles p {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
    margin-top: 0.2rem;
  }
  .badge {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--signature) 40%, transparent);
    background: color-mix(in oklab, var(--signature) 14%, transparent);
    color: var(--signature);
  }
</style>
