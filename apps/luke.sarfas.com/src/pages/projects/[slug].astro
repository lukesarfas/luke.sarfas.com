---
import Base from "~/layouts/Base.astro";
import Preview from "~/components/Preview.astro";
import { loadAll } from "~/lib/manifests";

export async function getStaticPaths() {
  const projects = await loadAll();
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const statusClass = project.status ? `status-${project.status}` : "";
---

<Base title={`${project.name} — Luke Sarfas`} description={project.tagline}>
  <a href="/projects" class="backlink" style="margin-top:1.5rem;display:inline-flex">← All projects</a>

  <header class="detail-head" style="margin-top:1.5rem">
    <h1>{project.name}</h1>
    {project.tagline && <p class="lead muted" style="max-width:60ch">{project.tagline}</p>}
    <div class="detail-meta">
      {project.status && <span class={`status ${statusClass}`}>{project.status}</span>}
      {project.version && <span>v{project.version}</span>}
      {project.updated && <span>updated {project.updated}</span>}
    </div>
  </header>

  <div class="detail-preview">
    <Preview project={project} />
  </div>

  {project.description && (
    <div class="detail-body">
      <p>{project.description}</p>
    </div>
  )}

  {project.links && (
    <div class="detail-actions">
      {project.links.site && <a class="btn btn-primary" href={project.links.site}>Visit site ↗</a>}
      {project.links.demo && <a class="btn" href={project.links.demo}>Live demo ↗</a>}
      {project.links.repo && <a class="btn" href={project.links.repo}>Source ↗</a>}
      {project.links.docs && <a class="btn" href={project.links.docs}>Docs ↗</a>}
    </div>
  )}

  {project.tags && project.tags.length > 0 && (
    <div style="margin-top:1.75rem">
      {project.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</Base>
