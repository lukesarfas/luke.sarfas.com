---
import Base from "~/layouts/Base.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  newer: CollectionEntry<"blog"> | null;
  older: CollectionEntry<"blog"> | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });

const words = post.body.trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(words / 220));

const SITE = "https://luke.sarfas.com";
const postUrl = `${SITE}/blog/${post.slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description ?? "",
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated ?? post.data.date).toISOString(),
    keywords: post.data.tags.join(", "),
    wordCount: words,
    timeRequired: `PT${readingMinutes}M`,
    inLanguage: "en-GB",
    author: { "@type": "Person", name: "Luke Sarfas", url: SITE },
    publisher: { "@type": "Person", name: "Luke Sarfas", url: SITE },
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    url: postUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
      { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---

<Base
  title={`${post.data.title} · Luke Sarfas`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={(post.data.updated ?? post.data.date).toISOString()}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article class="post">
    <a href="/blog/" class="backlink">← Blog</a>
    <header class="detail-head" style="margin-top:1.25rem">
      <span class="eyebrow">Post</span>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="post-deck">{post.data.description}</p>}
      <div class="detail-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.updated && (
          <span>· updated {fmt(post.data.updated)}</span>
        )}
        <span>· {readingMinutes} min read</span>
        {post.data.tags.length > 0 && (
          <span class="tags">
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </span>
        )}
      </div>
    </header>

    <div class="detail-body post-body">
      <Content />
    </div>

    <div class="post-foot">
      <a href="/blog/" class="backlink">← All posts</a>
      <a href="mailto:luke@sarfas.com?subject=Re: {post.data.title}" class="btn btn-ghost">Reply by email</a>
    </div>

    {(newer || older) && (
      <nav class="post-nav" aria-label="Other posts">
        {older && (
          <a href={`/blog/${older.slug}/`} class="post-nav-link post-nav-prev">
            <span class="muted">← Older</span>
            <strong>{older.data.title}</strong>
          </a>
        )}
        {newer && (
          <a href={`/blog/${newer.slug}/`} class="post-nav-link post-nav-next">
            <span class="muted">Newer →</span>
            <strong>{newer.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<script>
  function setup() {
    const bar = document.getElementById("read-progress");
    const article = document.querySelector(".post-body");
    if (!bar || !article) return;
    const tick = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
      const pct = total > 0 ? (scrolled / total) * 100 : 0;
      bar.style.setProperty("--p", `${pct}%`);
    };
    tick();
    window.addEventListener("scroll", tick, { passive: true });
    window.addEventListener("resize", tick);
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .post-deck {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.5;
    margin: 0;
  }
  .post-body {
    font-size: 1.05rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .post-body :global(pre),
  .post-body :global(img) {
    max-width: 100%;
  }
  .post-body :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 0.7rem;
  }
  .post-body :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.4rem;
  }
  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(pre),
  .post-body :global(blockquote) {
    margin-bottom: 1.1rem;
  }
  .post-body :global(pre) {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-2);
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .post-body :global(code) {
    font-size: 0.92em;
  }
  .post-body :global(blockquote) {
    border-left: 2px solid var(--border-strong);
    padding-left: 1.1rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .post-body :global(a) {
    color: var(--signature);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in oklab, var(--signature) 45%, transparent);
    transition: text-decoration-color 200ms var(--ease);
  }
  .post-body :global(a:hover) {
    text-decoration-color: var(--signature);
  }
  .post-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--fg);
    font-size: 0.95rem;
    transition: border-color 220ms var(--ease),
      background 220ms var(--ease),
      transform 220ms var(--ease);
  }
  .post-nav-link:hover {
    border-color: color-mix(in oklab, var(--signature) 35%, var(--border-strong));
    background: var(--card-hover);
    color: var(--fg);
    transform: translateY(-2px);
  }
  .post-nav-link strong {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
  }
  .post-nav-link .muted {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .post-nav-next {
    text-align: right;
    grid-column: 2;
  }
  .post-nav-prev:only-child {
    grid-column: 1 / -1;
  }
  @media (max-width: 600px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-next { grid-column: 1; text-align: left; }
  }
</style>
