---
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const SITE = "https://luke.sarfas.com";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Luke Sarfas",
    url: `${SITE}/blog/`,
    description: "Writing about what I'm building and thinking about.",
    author: { "@type": "Person", name: "Luke Sarfas", url: SITE },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: `${SITE}/blog/${p.slug}/`,
      datePublished: p.data.date.toISOString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
    ],
  },
];
---

<Base
  title="Blog · Luke Sarfas"
  description="Writing about what I'm building and thinking about. By Luke Sarfas, software engineer at Google."
  jsonLd={jsonLd}
>
  <section class="hero" style="grid-template-columns:1fr">
    <div class="hero-main">
      <span class="eyebrow">Writing</span>
      <h1>Blog</h1>
      <p class="lead">
        Notes on what I'm building and thinking about.
      </p>
    </div>
  </section>

  <section class="section" style="margin-top:3rem">
    {posts.length === 0 ? (
      <p class="muted">No posts yet.</p>
    ) : (
      <ol class="post-list">
        {posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.slug}/`} class="post-link">
              <span class="post-index">{String(i + 1).padStart(2, "0")}</span>
              <div class="post-content">
                <div class="post-meta">
                  <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                  {p.data.tags.length > 0 && <span class="dot" aria-hidden="true">·</span>}
                  {p.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
                </div>
                <h2 class="post-title">{p.data.title}</h2>
                {p.data.description && <p class="muted">{p.data.description}</p>}
              </div>
              <span class="post-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .post-list li { border-bottom: 1px solid var(--border); }
  .post-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.6rem 1rem;
    color: var(--fg);
    transition: background 240ms var(--ease), padding 240ms var(--ease);
  }
  .post-link:hover {
    background: var(--card);
    color: var(--fg);
    padding-left: 1.5rem;
  }
  .post-meta { flex-wrap: wrap; }
  .post-index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }
  .post-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .post-meta .dot { opacity: 0.5; }
  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }
  .post-link p {
    max-width: 60ch;
    margin: 0;
    line-height: 1.5;
  }
  .post-arrow {
    font-size: 1.2rem;
    color: var(--muted);
    transition: color 220ms var(--ease), transform 220ms var(--ease);
    padding-top: 0.2rem;
  }
  .post-link:hover .post-arrow {
    color: var(--signature);
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .post-link {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.85rem;
      padding: 1.1rem 0.3rem;
    }
    .post-link:hover { padding-left: 0.5rem; }
    .post-arrow { display: none; }
    .post-title { font-size: 1.2rem; }
  }
</style>
