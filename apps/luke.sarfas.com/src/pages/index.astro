---
import Base from "~/layouts/Base.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { loadAll } from "~/lib/manifests";

const projects = await loadAll();
projects.sort((a, b) => (b.updated ?? "").localeCompare(a.updated ?? ""));
const featured = projects.slice(0, 6);

const SITE = "https://luke.sarfas.com";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Luke Sarfas",
    url: SITE,
    jobTitle: "Software Engineer",
    description:
      "Software engineer and machine-learning practitioner. Currently at Google, previously Amazon.",
    address: {
      "@type": "PostalAddress",
      addressLocality: "London",
      addressCountry: "GB",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "University of Warwick",
    },
    sameAs: ["https://www.linkedin.com/in/lukesarfas/"],
    email: "mailto:luke@sarfas.com",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Luke Sarfas",
    url: SITE,
    author: { "@type": "Person", name: "Luke Sarfas" },
  },
];
---

<Base
  title="Luke Sarfas · Software engineer, builder, writer"
  description="Personal site of Luke Sarfas. Software engineer at Google, previously Amazon. Side projects, writing, and what I'm building."
  jsonLd={jsonLd}
>
  <section class="hero">
    <span class="eyebrow fade-in">Independent builder</span>
    <h1 class="fade-in fade-in-1">
      I build things,<br />
      <span class="gradient-text">and write about them.</span>
    </h1>
    <p class="lead fade-in fade-in-2">
      Personal projects, experiments, and the occasional product. Everything here is
      mine; nothing is sponsored. Updated automatically as each project ships.
    </p>
    <div class="actions fade-in fade-in-3">
      <a class="btn btn-primary" href="/projects">See projects →</a>
      <a class="btn" href="/contact">Get in touch</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Currently building</h2>
      {projects.length > 6 && <a href="/projects" class="muted">All projects →</a>}
    </div>
    {featured.length === 0 ? (
      <p class="muted">No projects registered yet. Add entries to <code>src/data/projects.json</code>.</p>
    ) : (
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    )}
  </section>
</Base>
