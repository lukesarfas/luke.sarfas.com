---
import Base from "~/layouts/Base.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import { loadAll } from "~/lib/manifests";
import { getCollection } from "astro:content";

const projects = await loadAll();
projects.sort((a, b) => (b.updated ?? "").localeCompare(a.updated ?? ""));
const featured = projects.slice(0, 6);

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latest = posts[0] ?? null;

const SITE = "https://luke.sarfas.com";

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Luke Sarfas",
    url: SITE,
    jobTitle: "Software Engineer",
    description:
      "Software engineer and machine-learning practitioner. Currently at Google, previously Amazon.",
    address: {
      "@type": "PostalAddress",
      addressLocality: "London",
      addressCountry: "GB",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "University of Warwick",
    },
    sameAs: ["https://www.linkedin.com/in/lukesarfas/"],
    email: "mailto:luke@sarfas.com",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Luke Sarfas",
    url: SITE,
    author: { "@type": "Person", name: "Luke Sarfas" },
  },
];
---

<Base
  title="Luke Sarfas, software engineer and builder"
  description="Personal site of Luke Sarfas. Software engineer at Google, previously Amazon. Side projects, writing, and what I'm building."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-main">
      <span class="eyebrow fade-in">Independent builder, London</span>
      <h1 class="fade-in fade-in-1">
        I build things,<br />
        <em>and write about them.</em>
      </h1>
      <p class="lead fade-in fade-in-2">
        Software engineer at Google by day, builder by night. Side projects,
        experiments, and the occasional shipped product. Everything here is mine.
        Nothing is sponsored.
      </p>
      <div class="actions fade-in fade-in-3">
        <a class="btn btn-primary" href="/projects/">
          See projects <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn" href="/blog/">Read the blog</a>
      </div>
    </div>

    <aside class="hero-side fade-in fade-in-4" aria-label="Current status">
      <div class="status-card">
        <div class="row">
          <span>Status</span>
          <span class="live">Available to chat</span>
        </div>
        <div class="row">
          <span>Based</span>
          <span>London, UK</span>
        </div>
        <div class="row">
          <span>Building</span>
          <span><a href="/projects/thinkwell/">ThinkWell</a></span>
        </div>
        <div class="row">
          <span>Working</span>
          <span>Google</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Currently building</h2>
      {projects.length > 6 && <a href="/projects/" class="muted">All projects →</a>}
    </div>
    {featured.length === 0 ? (
      <p class="muted">No projects registered yet.</p>
    ) : (
      <div class="grid">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    )}
  </section>

  {latest && (
    <section class="section latest-writing">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a href="/blog/" class="muted">All posts →</a>
      </div>
      <a class="latest-card" href={`/blog/${latest.slug}/`}>
        <div class="latest-meta">
          <time datetime={latest.data.date.toISOString()}>{fmt(latest.data.date)}</time>
          {latest.data.tags.length > 0 && (
            <span class="dot" aria-hidden="true">·</span>
          )}
          {latest.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
        </div>
        <h3 class="latest-title">{latest.data.title}</h3>
        {latest.data.description && <p class="muted latest-desc">{latest.data.description}</p>}
        <span class="latest-read">Read post <span aria-hidden="true">→</span></span>
      </a>
    </section>
  )}
</Base>

<style>
  .latest-card {
    display: block;
    padding: 2rem 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    color: var(--fg);
    transition: border-color 280ms var(--ease),
      background 280ms var(--ease),
      transform 280ms var(--ease),
      box-shadow 280ms var(--ease);
    position: relative;
    overflow: hidden;
  }
  .latest-card::after {
    content: "";
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle,
      color-mix(in oklab, var(--signature) 10%, transparent),
      transparent 60%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }
  .latest-card:hover {
    border-color: color-mix(in oklab, var(--signature) 35%, var(--border-strong));
    background: var(--card-hover);
    color: var(--fg);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .latest-card:hover::after { opacity: 1; }
  .latest-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .latest-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0;
  }
  .latest-desc {
    margin-top: 0.7rem;
    font-size: 1rem;
    max-width: 60ch;
  }
  .latest-read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    color: var(--signature);
    font-size: 0.92rem;
    font-weight: 500;
    transition: gap 220ms var(--ease);
  }
  .latest-card:hover .latest-read { gap: 0.65rem; }
</style>
