---
import Base from "~/layouts/Base.astro";

const fmtMonth = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<Base title="Now · Luke Sarfas" description="What I'm focused on right now.">
  <section class="hero" style="grid-template-columns:1fr">
    <div class="hero-main">
      <span class="eyebrow">{fmtMonth}</span>
      <h1>Now</h1>
      <p class="lead">
        What I'm focused on right now.
      </p>
    </div>
  </section>

  <section class="section" style="margin-top:3rem">
    <div class="now-grid">
      <article class="now-card">
        <span class="eyebrow">Work</span>
        <h2>Software engineer at Google, London.</h2>
      </article>

      <article class="now-card">
        <span class="eyebrow">Building</span>
        <h2><a href="/projects/thinkwell/">ThinkWell</a></h2>
        <p>AI-assisted personal journaling.</p>
      </article>

      <article class="now-card">
        <span class="eyebrow">Writing</span>
        <h2><a href="/blog/">Blog</a></h2>
      </article>

    </div>
  </section>
</Base>

<style>
  .now-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }
  .now-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.4rem 1.5rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    transition: border-color 240ms var(--ease), background 240ms var(--ease);
  }
  .now-card:hover {
    border-color: color-mix(in oklab, var(--signature) 30%, var(--border-strong));
    background: var(--card-hover);
  }
  .now-card h2 {
    font-size: 1.35rem;
    line-height: 1.15;
  }
  .now-card p {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.5;
  }
</style>
