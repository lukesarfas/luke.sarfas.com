---
import Base from "~/layouts/Base.astro";

const updated = "2026-05-19";
---

<Base title="Now · Luke Sarfas" description="What I'm focused on right now.">
  <section class="hero" style="padding-top:3rem;padding-bottom:0">
    <span class="eyebrow">Now</span>
    <h1>What I'm doing <span class="gradient-text">right now</span></h1>
    <p class="lead">
      A snapshot of what has my attention this season: work, side projects,
      and the things I'm learning. Inspired by <a href="https://nownownow.com/about" rel="noreferrer">nownownow</a>.
    </p>
  </section>

  <section class="section" style="margin-top:2.5rem">
    <div class="prose">
      <h2>Building</h2>
      <p class="muted">TODO: what you're shipping this month.</p>

      <h2>Learning</h2>
      <p class="muted">TODO: books, courses, ideas you're chewing on.</p>

      <h2>Life</h2>
      <p class="muted">TODO: where you are, what's good, what's hard.</p>

      <p class="updated muted">Last updated {updated}</p>
    </div>
  </section>
</Base>

<style>
  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
  }
  .prose p {
    margin-bottom: 0.8rem;
    max-width: 70ch;
  }
  .updated {
    margin-top: 2.5rem;
    font-size: 0.85rem;
  }
</style>
