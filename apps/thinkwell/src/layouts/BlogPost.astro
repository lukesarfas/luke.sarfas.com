---
import Base from "~/layouts/Base.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title: string;
  excerpt?: string;
  date: Date;
  path: string;
}
const { title, excerpt, date, path } = Astro.props;
const formattedDate = date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title={`${title} — ThinkWell`}
  description={excerpt ?? title}
  path={path}
>
  <Header />
  <main>
    <article class="container blog-prose">
      <a class="back-link" href="/blog/">← All posts</a>
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </p>
      <div class="blog-body">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  .blog-prose {
    max-width: 680px;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    font-family: var(--font-ui);
    color: var(--text);
    line-height: 1.75;
  }
  .blog-prose .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
  .blog-prose h1 {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .blog-prose .post-meta {
    color: var(--text-muted);
    margin: 0 0 2rem;
    font-size: 0.92rem;
  }
  .blog-body h2 {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    margin: 2.25rem 0 0.5rem;
    color: var(--text);
  }
  .blog-body h3 {
    font-size: 1.15rem;
    margin: 1.75rem 0 0.5rem;
    color: var(--text);
  }
  .blog-body p,
  .blog-body ul,
  .blog-body ol,
  .blog-body blockquote {
    margin: 0 0 1.1rem;
    color: var(--text-secondary);
  }
  .blog-body ul,
  .blog-body ol {
    padding-left: 1.25rem;
  }
  .blog-body li {
    margin-bottom: 0.4rem;
  }
  .blog-body blockquote {
    border-left: 3px solid var(--accent-soft);
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--text);
    font-style: italic;
  }
  .blog-body strong {
    color: var(--text);
  }
  .blog-body a {
    color: var(--accent-strong);
  }
  .blog-body code {
    font-family:
      ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    background: var(--sunken);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.92em;
  }
</style>
