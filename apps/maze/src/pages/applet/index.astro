---
const title = "A* Maze Solver — embed";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <style>
      :root {
        --bg: #15171d;
        --panel: #1b1e26;
        --fg: #eef0f5;
        --muted: #9aa1b2;
        --line: #2a2e3a;
        --accent: #f4e84a;
        /* Colour-blind-safe palette with a luminance gap so adjacent states
           clear WCAG 1.4.11 (≥3:1) on the dark background. Read by solver.js. */
        --maze-bg: #15171d;
        --maze-wall: #646b85; /* light slate */
        --maze-explored: #356a90; /* dark blue */
        --maze-frontier: #f0c878; /* light amber */
        --maze-path: #f4e84a; /* bright yellow */
        --maze-start: #15c487; /* bluish-green */
        --maze-goal: #e7672e; /* vermillion */
        --maze-current: #ffffff;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
      }
      .stage {
        display: flex;
        gap: 18px;
        align-items: stretch;
        width: 100%;
        height: 100%;
        max-height: 620px;
      }
      .board {
        flex: 0 0 auto;
        height: 100%;
        aspect-ratio: 1 / 1;
        background: var(--maze-bg);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
      }
      canvas { display: block; width: 100%; height: 100%; }
      canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .panel {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
        justify-content: center;
      }
      .panel h1 { margin: 0; font-size: 17px; letter-spacing: -0.01em; }
      .panel p { margin: 0; font-size: 12.5px; color: var(--muted); line-height: 1.5; }
      .stats { display: grid; gap: 8px; }
      .stat {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: var(--muted);
        border-bottom: 1px dashed var(--line);
        padding-bottom: 6px;
      }
      .stat b { color: var(--fg); font-variant-numeric: tabular-nums; }
      .row { display: flex; gap: 8px; flex-wrap: wrap; }
      button {
        flex: 1;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        color: var(--fg);
        font: inherit;
        font-size: 12.5px;
        cursor: pointer;
      }
      button:hover { border-color: var(--accent); }
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      a.repo { font-size: 11.5px; color: var(--muted); text-decoration: none; }
      a.repo:hover { color: var(--accent); }
      .kbd-hint { font-size: 11px; color: var(--muted); margin: 0; }
      kbd {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 0.82em; background: var(--bg); border: 1px solid var(--line);
        border-bottom-width: 2px; border-radius: 4px; padding: 0 0.3em;
      }
      .visually-hidden {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }
      @media (max-width: 540px) {
        .stage { flex-direction: column; max-height: none; }
        .board { height: auto; width: 100%; }
        .panel { justify-content: flex-start; }
      }
    </style>
  </head>
  <body>
    <main class="stage">
      <div class="board">
        <canvas
          id="maze"
          role="img"
          tabindex="0"
          aria-label="A maze with the A* search animating: explored cells, frontier, and shortest path."
        ></canvas>
      </div>
      <div class="panel">
        <h1>A* Maze Solver</h1>
        <p>Recursive-backtracking maze, solved with A* and a Manhattan heuristic. The amber cells are the search frontier; the bright yellow line is the shortest path.</p>
        <div class="stats">
          <div class="stat"><span>Explored</span><b id="s-explored">0</b></div>
          <div class="stat"><span>Frontier</span><b id="s-frontier">0</b></div>
          <div class="stat"><span>Path length</span><b id="s-path">—</b></div>
        </div>
        <div class="row">
          <button id="toggle" type="button">Pause</button>
          <button id="new" type="button">New maze</button>
        </div>
        <p class="kbd-hint"><kbd>Space</kbd> play/pause · <kbd>N</kbd> new maze</p>
        <a class="repo" href="https://github.com/lukesarfas/A-Star-Maze-Algorithm-Solver" target="_top" rel="noopener">View source ↗</a>
      </div>
    </main>
    <div id="a11y-status" class="visually-hidden" role="status" aria-live="polite"></div>

    <script type="module" src="../engine/applet.js" is:inline></script>
  </body>
</html>
