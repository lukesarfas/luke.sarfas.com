---
import "~/styles/global.css";
import MetaTags from "@sarfas/ui/MetaTags.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = "/sites/maze/" } = Astro.props;
const site = Astro.site ?? new URL("https://luke.sarfas.com");
const url = new URL(path, site).toString();
const ogImage = new URL("/sites/maze/preview.png", site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e0f13" />
    <link rel="icon" href="/sites/maze/favicon.svg" type="image/svg+xml" />
    <MetaTags title={title} description={description} url={url} image={ogImage} imageAlt="A* maze solver" />
  </head>
  <body>
    <slot />
  </body>
</html>
